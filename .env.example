# ---------------------------------------------------------------------------
# Copy this file to .env.local (never commit real values) and fill it in.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase or Vercel Postgres)
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Vercel Blob token — created when you connect a Blob store to the project.
# Leave empty locally to save uploads to ./uploads instead.
BLOB_READ_WRITE_TOKEN=

# Sign the admin session with a long random string
SESSION_SECRET=change-this-to-a-long-random-string

# Admin login (defaults to admin / admin123 if unset)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
